        "name": "包裝報表",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          1530
        ],
        "parameters": {
          "jsCode": "const rows = $input.all().map(x => x.json);\nconst revenue_total = rows.reduce((s,r)=>s+(parseInt(r.revenue,10)||0),0);\nconst orders_total = rows.reduce((s,r)=>s+(parseInt(r.orders,10)||0),0);\nreturn [{ json: { ok: true, daily: rows, revenue_total, orders_total } }];"
        }
      },
