      {
        "id": "pg013",
        "name": "簽發token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          340
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH s AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nt AS (SELECT ($1::jsonb->>'username') AS u, ($1::jsonb->>'role') AS r, (extract(epoch FROM now())::bigint + 43200) AS exp)\nSELECT t.u||'|'||t.r||'|'||t.exp||'|'||encode(hmac(t.u||'|'||t.r||'|'||t.exp, s.secret, 'sha256'),'hex') AS role_token,\n       t.exp AS exp, t.u AS username, t.r AS role\nFROM s, t",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('核對PIN').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
