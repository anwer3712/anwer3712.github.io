        "parameters": {
          "jsCode": "const v = $json; const req = $('解析輸入').item.json;\nconst selfService = req.actor && req.actor === req.target_username;\nconst ok = v.valid === true && (v.verified_role === 'owner' || selfService)\n  && ['enable','disable'].includes(req.totp_action);\nreturn [{ json: { ok, actor: req.actor, role: req.role, target_username: req.target_username, totp_action: req.totp_action, secret_base32: req.secret_base32, totp_code: req.totp_code } }];"
