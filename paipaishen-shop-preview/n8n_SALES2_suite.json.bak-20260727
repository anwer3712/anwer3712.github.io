          170
        ],
        "parameters": {
          "fromEmail": "={{ 'noreply@paipaishen.local' }}",
          "toEmail": "={{ $json.to }}",
          "subject": "={{ $json.subject }}",
          "emailFormat": "html",
          "options": {},
          "html": "={{ $json.html }}"
        },
        "onError": "continueRegularOutput",
        "credentials": {
          "smtp": {
            "id": "PLACEHOLDER_GMAIL_SMTP",
            "name": "Gmail_SMTP_佔位"
          }
        }
      },
