      {
        "id": "pg192",
        "name": "驗Token_profile_get",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          510
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\ns AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nparts AS (SELECT string_to_array(coalesce((SELECT j->>'member_token' FROM p),''), '|') AS a),\nvalid_shape AS (SELECT a FROM parts WHERE array_length(a,1)=4 AND a[1]='member' AND a[2] ~ '^[0-9]+$' AND a[3] ~ '^[0-9]+$')\nSELECT EXISTS (\n  SELECT 1 FROM valid_shape v, s\n  WHERE v.a[3]::bigint > extract(epoch FROM now())::bigint\n    AND v.a[4] = encode(hmac(v.a[1]||'|'||v.a[2]||'|'||v.a[3], s.secret, 'sha256'), 'hex')\n) AS valid, (SELECT (v.a[2])::bigint FROM valid_shape v LIMIT 1) AS member_id",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
