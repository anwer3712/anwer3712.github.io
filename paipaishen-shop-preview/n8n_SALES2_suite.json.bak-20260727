        "id": "cd180",
        "name": "解析輸入",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nif (JSON.stringify(b).length > 4000) throw new Error('payload too big');\nconst op = String(b.op || '');\nconst OPS = ['member_otp_request','member_otp_verify','member_profile_get','member_profile_update','member_orders'];\nconst idx = OPS.indexOf(op);\nif (idx < 0) throw new Error('bad op');\nif (b.token !== \"pps_07ae287ed522c33e0422fdd4837d97bf\") throw new Error('bad token');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nreturn [{ json: {\n  _branch: idx, op,\n  email: s(b.email, 100).trim().toLowerCase(), otp_code: s(b.otp_code, 10),\n  member_token: s(b.member_token, 300),\n  profile: (b.profile && typeof b.profile === 'object') ? b.profile : {},\n  name: s(b.name, 40)\n} }];"
        }
      },
      {
        "id": "sw181",
        "name": "分流",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          520,
          0
        ],
        "parameters": {
          "mode": "expression",
          "numberOutputs": 5,
          "output": "={{ $json._branch }}"
        }
      },
      {
        "id": "pg182",
        "name": "查建會員並產OTP",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          170
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH gen AS (\n  SELECT lpad((floor(random()*1000000))::int::text,6,'0') AS code\n),\ntarget AS (\n  (SELECT id FROM pps2_members WHERE login_email = $1::jsonb->>'email' LIMIT 1)\n  UNION ALL\n  (SELECT id FROM pps2_members WHERE login_email IS NULL AND contact = $1::jsonb->>'email' LIMIT 1)\n  LIMIT 1\n),\nupd AS (\n  UPDATE pps2_members m SET\n    login_email = $1::jsonb->>'email',\n    otp_hash = encode(digest(($1::jsonb->>'email')||'|'||(SELECT code FROM gen),'sha256'),'base64'),\n    otp_expires = now() + interval '10 minutes', updated_at = now()\n  WHERE m.id IN (SELECT id FROM target)\n  RETURNING m.id\n),\nins AS (\n  INSERT INTO pps2_members(contact, login_email, otp_hash, otp_expires)\n  SELECT $1::jsonb->>'email', $1::jsonb->>'email',\n         encode(digest(($1::jsonb->>'email')||'|'||(SELECT code FROM gen),'sha256'),'base64'),\n         now() + interval '10 minutes'\n  FROM gen\n  WHERE NOT EXISTS (SELECT 1 FROM target)\n  ON CONFLICT (contact) DO UPDATE SET\n    login_email = EXCLUDED.login_email, otp_hash = EXCLUDED.otp_hash, otp_expires = EXCLUDED.otp_expires, updated_at = now()\n  RETURNING id\n)\nSELECT coalesce((SELECT id FROM upd), (SELECT id FROM ins)) AS member_id, (SELECT code FROM gen) AS otp_code, $1::jsonb->>'email' AS email",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "cd183",
        "name": "準備OTP信件",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          170
        ],
        "parameters": {
          "jsCode": "const r = $json;\nreturn [{ json: {\n  to: r.email,\n  subject: '【拍拍深】您的登入驗證碼',\n  html: '<p>您的一次性登入驗證碼為 <b>'+r.otp_code+'</b>，10 分鐘內有效，請勿提供給他人。</p>'\n} }];"
        }
      },
      {
        "id": "em184",
        "name": "寄OTP信件",
