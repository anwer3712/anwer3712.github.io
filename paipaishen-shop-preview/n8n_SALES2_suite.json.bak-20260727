      {
        "id": "pg176",
        "name": "營收聚合",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          2380
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT to_char(date_trunc('day', paid_at), 'YYYY-MM-DD') AS day, method, order_type, count(*) AS payments, sum(amount) AS revenue\nFROM pps2_payments\nWHERE ($1::jsonb->'payload'->>'date_from' IS NULL OR paid_at >= ($1::jsonb->'payload'->>'date_from')::timestamptz)\n  AND ($1::jsonb->'payload'->>'date_to'   IS NULL OR paid_at <  ($1::jsonb->'payload'->>'date_to')::timestamptz + interval '1 day')\n  AND ($1::jsonb->'payload'->>'method'     IS NULL OR method = $1::jsonb->'payload'->>'method')\n  AND ($1::jsonb->'payload'->>'order_type' IS NULL OR order_type = $1::jsonb->'payload'->>'order_type')\nGROUP BY 1,2,3 ORDER BY 1",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('角色閘').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd177",
        "name": "包裝營收報表",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          2380
        ],
        "parameters": {
          "jsCode": "const rows = $input.all().map(x => x.json);\nconst revenue_total = rows.reduce((s,r)=>s+(parseInt(r.revenue,10)||0),0);\nconst payments_total = rows.reduce((s,r)=>s+(parseInt(r.payments,10)||0),0);\nconst by_method = {}; rows.forEach(r => { by_method[r.method] = (by_method[r.method]||0) + (parseInt(r.revenue,10)||0); });\nreturn [{ json: { ok: true, rows, revenue_total, payments_total, by_method } }];"
        }
      },
