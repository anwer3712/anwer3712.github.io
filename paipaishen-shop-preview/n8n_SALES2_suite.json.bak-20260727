        "id": "cd016",
        "name": "角色閘register",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          780,
          340
        ],
        "parameters": {
          "jsCode": "const v = $json; const req = $('解析輸入').item.json;\nconst ok = v.valid === true && v.verified_role === 'owner'\n  && req.new_username && req.new_pin_hash && [\"owner\",\"客服\",\"倉管\",\"行銷\"].includes(req.new_role);\nreturn [{ json: { ok, actor: req.actor, role: req.role, new_username: req.new_username, new_pin_hash: req.new_pin_hash, new_role: req.new_role } }];"
        }
      },
