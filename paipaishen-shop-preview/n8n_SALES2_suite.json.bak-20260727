          "query": "INSERT INTO pps2_admin_users(username,pin_hash,role,status)\nSELECT $1::jsonb->'payload'->>'username', COALESCE(NULLIF($1::jsonb->'payload'->>'pin_hash',''),'CHANGE_ME'),\n       COALESCE(NULLIF($1::jsonb->'payload'->>'role',''),'客服'), COALESCE(NULLIF($1::jsonb->'payload'->>'status',''),'啟用')\nON CONFLICT (username) DO UPDATE SET\n  role = COALESCE(NULLIF(EXCLUDED.role,''), pps2_admin_users.role),\n  status = COALESCE(NULLIF(EXCLUDED.status,''), pps2_admin_users.status),\n  pin_hash = CASE WHEN NULLIF($1::jsonb->'payload'->>'pin_hash','') IS NOT NULL THEN EXCLUDED.pin_hash ELSE pps2_admin_users.pin_hash END,\n  updated_at = now()\nRETURNING username, role, status",
