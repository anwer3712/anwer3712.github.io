  {
    "id": "pps2Notify01",
    "name": "pps2-notify",
    "active": true,
    "nodes": [
      {
        "id": "wh136",
        "name": "Webhook 通知",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "pps2-notify",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "pps2-notify"
      },
      {
        "id": "cd137",
        "name": "解析輸入",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nif (JSON.stringify(b).length > 6000) throw new Error('payload too big');\nconst op = String(b.op || 'send');\nif (!['send','test'].includes(op)) throw new Error('bad op');\nconst channel = String(b.channel || 'email');\nif (!['email','tg','sms'].includes(channel)) throw new Error('bad channel');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nreturn [{ json: {\n  op, channel, role_token: s(b.role_token, 400), actor: s(b.actor, 30), role: s(b.role, 10),\n  to: s(b.to, 100), test_to: s(b.test_to, 100), template_key: s(b.template_key, 30),\n  subject: s(b.subject, 200), html: s(b.html, 4000), vars: (b.vars && typeof b.vars === 'object') ? b.vars : {}\n} }];"
        }
      },
      {
        "id": "pg138",
        "name": "驗Token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          520,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\ns AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nparts AS (SELECT string_to_array(coalesce((SELECT j->>'role_token' FROM p),''), '|') AS a),\nvalid_shape AS (SELECT a FROM parts WHERE array_length(a,1)=4 AND a[3] ~ '^[0-9]+$')\nSELECT EXISTS (\n  SELECT 1 FROM valid_shape v, s\n  WHERE v.a[1] = (SELECT j->>'actor' FROM p)\n    AND v.a[2] = (SELECT j->>'role' FROM p)\n    AND v.a[3]::bigint > extract(epoch FROM now())::bigint\n    AND v.a[4] = encode(hmac(v.a[1]||'|'||v.a[2]||'|'||v.a[3], s.secret, 'sha256'), 'hex')\n) AS valid, (SELECT j->>'role' FROM p) AS verified_role",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd139",
        "name": "角色閘",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          780,
          0
        ],
        "parameters": {
          "jsCode": "const v = $json; const req = $('解析輸入').item.json;\nconst ok = v.valid === true && [\"owner\",\"客服\"].includes(v.verified_role);\nreturn [{ json: Object.assign({ ok }, req) }];"
        }
      },
      {
        "id": "if140",
        "name": "授權通過?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1040,
          0
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "version": 2
            },
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ $json.ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "rs141",
        "name": "回應無權限",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1300,
          0
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: false, error: 'forbidden' } }}",
          "options": {}
        }
      },
      {
        "id": "pg142",
        "name": "取範本設定",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          170
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT value FROM pps2_settings WHERE key='notify_templates'",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "cd143",
        "name": "套版",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          170
        ],
        "parameters": {
          "jsCode": "const g = $('角色閘').item.json;\nconst templates = $json.value || {};\nconst tpl = (g.template_key && templates[g.template_key]) ? templates[g.template_key] : { subject: g.subject, html: g.html };\nconst vars = g.vars || {};\nconst fill = (str) => String(str || '').replace(/\\{\\{(\\w+)\\}\\}/g, (_, k) => String(vars[k] ?? ''));\nconst isTest = g.op === 'test';\nconst html = fill(tpl.html);\nreturn [{ json: {\n  channel: g.channel, to: isTest ? (g.test_to || g.to) : g.to,\n  subject: fill(tpl.subject) || '拍拍深通知', html, text: html.replace(/<[^>]+>/g, '')\n} }];"
        }
      },
      {
        "id": "sw144",
        "name": "分流channel",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          520,
          170
        ],
        "parameters": {
          "mode": "expression",
          "numberOutputs": 3,
          "output": "={{ ({email:0,tg:1,sms:2})[$json.channel] }}"
        }
      },
      {
        "id": "em145",
        "name": "寄Email",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [
          780,
          170
        ],
        "parameters": {
          "fromEmail": "={{ 'noreply@paipaishen.local' }}",
          "toEmail": "={{ $json.to }}",
          "subject": "={{ $json.subject }}",
          "emailFormat": "html",
          "options": {},
          "html": "={{ $json.html }}"
        },
        "onError": "continueRegularOutput",
        "credentials": {
          "smtp": {
            "id": "PLACEHOLDER_GMAIL_SMTP",
            "name": "Gmail_SMTP_佔位"
          }
        }
      },
      {
        "id": "rs146",
        "name": "回應email",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1040,
          170
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: true, channel: 'email' } }}",
          "options": {}
        }
      },
      {
        "id": "ht147",
        "name": "推TG",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1300,
          170
        ],
        "parameters": {
          "method": "POST",
          "url": "https://api.telegram.org/bot8979621738:AAFKozzU9n9s4ql8xagfWO2blhQxiOMnDHg/sendMessage",
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ chat_id: 8410048576, parse_mode:'HTML', disable_web_page_preview:true, text: $json.subject + '\\n' + $json.text }) }}",
          "options": {}
        },
        "onError": "continueRegularOutput"
      },
      {
        "id": "rs148",
        "name": "回應tg",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          0,
          340
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: true, channel: 'tg' } }}",
          "options": {}
        }
      },
      {
        "id": "rs149",
        "name": "回應sms",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          260,
          340
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: false, error: 'not_configured' } }}",
          "options": {}
        }
      }
    ],
