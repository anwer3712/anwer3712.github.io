  {
    "id": "pps2ShopOrder01",
    "name": "pps2-shop-order",
    "active": true,
    "nodes": [
      {
        "id": "wh064",
        "name": "Webhook 建單",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "pps2-shop-order",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "pps2-shop-order"
      },
      {
        "id": "cd065",
        "name": "驗證與正規化",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nconst SITE = \"pps_07ae287ed522c33e0422fdd4837d97bf\";\nif (b.token !== SITE) throw new Error('bad token');\nconst o = b.order || {};\nif (JSON.stringify(o).length > 8000) throw new Error('payload too big');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nconst items = Array.isArray(o.items) ? o.items : [];\nif (items.length < 1 || items.length > 30) throw new Error('bad items');\nconst cleanItems = items.map(it => {\n  const id = parseInt(it.id, 10), qty = parseInt(it.qty, 10);\n  if (!(id > 0) || !(qty > 0 && qty <= 50)) throw new Error('bad item line');\n  return { id, qty };\n});\nconst shipping = Math.max(0, Math.min(2000, parseInt(o.shipping, 10) || 0));\nconst coupon_code = s(o.coupon_code, 30).trim().toUpperCase();\nreturn [{ json: {\n  items: cleanItems,\n  shipping, coupon_code,\n  ship_method: s(o.ship_method, 20), ship_label: s(o.ship_label, 30),\n  pay_method: s(o.pay_method, 20), pay_label: s(o.pay_label, 30),\n  customer_name: s(o.name, 40).trim(), contact: s(o.contact, 60).trim(), note: s(o.note, 500),\n  raw: o\n} }];"
        }
      },
      {
        "id": "cd066",
        "name": "展開品項",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          520,
          0
        ],
        "parameters": {
          "jsCode": "const items = $('驗證與正規化').item.json.items;\nreturn items.map(it => ({ json: { id: it.id, qty: it.qty } }));"
        }
      },
      {
        "id": "pg067",
        "name": "逐項扣庫存",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          780,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\ntarget AS (SELECT (p.j->>'id')::bigint AS id, (p.j->>'qty')::int AS qty FROM p),\ncur AS (SELECT * FROM pps2_products WHERE id = (SELECT id FROM target)),\nupd AS (\n  UPDATE pps2_products pr SET stock = pr.stock - t.qty\n  FROM target t WHERE pr.id = t.id AND pr.stock >= t.qty\n  RETURNING pr.id\n)\nSELECT t.id AS product_id, t.qty AS qty, cur.price, cur.name, (upd.id IS NOT NULL) AS ok\nFROM target t LEFT JOIN cur ON cur.id = t.id LEFT JOIN upd ON upd.id = t.id",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "cd068",
        "name": "彙整結果",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1040,
          0
        ],
        "parameters": {
          "jsCode": "const lines = $input.all().map(x => x.json);\nconst all_ok = lines.length > 0 && lines.every(l => l.ok === true);\nconst out_of_stock_ids = lines.filter(l => !l.ok).map(l => l.product_id);\nconst rollback = lines.filter(l => l.ok).map(l => ({ id: l.product_id, qty: l.qty }));\nconst items_priced = lines.map(l => ({ product_id: l.product_id, name: l.name, price: l.price, qty: l.qty }));\nconst order = $('驗證與正規化').item.json;\nconst subtotal = lines.reduce((sum, l) => sum + (l.price || 0) * l.qty, 0);\n\n// 運費：後端依 shipping_rules + ship_method 算，前端值僅供比對標註\n// (ponytail: shipping_rules 缺鍵/漏 seed 時退回前端值，避免全站誤判免運)\nconst rules = ($('查運費與優惠券').item.json.shipping_rules) || {};\nconst rule = rules[order.ship_method];\nconst shipping_backend = (rule && typeof rule.fee === 'number') ? rule.fee : order.shipping;\nconst shipping_mismatch = shipping_backend !== order.shipping;\n\n// 優惠券：查回結果驗效期/次數/門檻，無效碼一律擋單不靜默忽略\nconst coupon = $('查運費與優惠券').item.json.coupon;\nlet coupon_error = null, coupon_discount = 0;\nif (order.coupon_code) {\n  if (!coupon || coupon.status !== '啟用') coupon_error = 'coupon_invalid';\n  else if (coupon.expires_at && new Date(coupon.expires_at).getTime() < Date.now()) coupon_error = 'coupon_expired';\n  else if (coupon.max_uses != null && coupon.used_count >= coupon.max_uses) coupon_error = 'coupon_invalid';\n  else if (subtotal < (coupon.min_amount || 0)) coupon_error = 'coupon_min_amount';\n  else {\n    coupon_discount = coupon.discount_percent ? Math.round(subtotal * coupon.discount_percent / 100) : (coupon.discount_amount || 0);\n    coupon_discount = Math.max(0, Math.min(coupon_discount, subtotal));\n  }\n}\n\nconst proceed = all_ok && !coupon_error;\nconst amount_total = subtotal - coupon_discount + shipping_backend;\nreturn [{ json: {\n  all_ok, proceed, out_of_stock_ids, coupon_error, rollback, items_priced, amount_total,\n  customer_name: order.customer_name, contact: order.contact,\n  ship_method: order.ship_method, payment_method: order.pay_method, coupon_code: order.coupon_code,\n  raw: Object.assign({}, order.raw, {\n    ship_label: order.ship_label, pay_label: order.pay_label, note: order.note,\n    coupon_code: order.coupon_code || null, coupon_discount,\n    shipping_frontend: order.shipping, shipping_backend, shipping_mismatch\n  })\n} }];"
        }
      },
      {
        "id": "if069",
        "name": "可建單?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1300,
          0
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "version": 2
            },
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ $json.proceed }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "pg070",
        "name": "建立訂單",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          170
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO pps2_shop_orders(order_no,items,amount_total,customer_name,contact,ship_method,payment_method,status,raw)\nSELECT 'P'||to_char(now() at time zone 'Asia/Taipei','YYYYMMDD')||'-'||lpad((count(*)+1)::text,3,'0'),\n       ($1::jsonb->'items_priced'), ($1::jsonb->>'amount_total')::int, $1::jsonb->>'customer_name', $1::jsonb->>'contact',\n       $1::jsonb->>'ship_method', $1::jsonb->>'payment_method', '新單', ($1::jsonb->'raw')\nFROM pps2_shop_orders WHERE order_no LIKE 'P'||to_char(now() at time zone 'Asia/Taipei','YYYYMMDD')||'-%'\nRETURNING order_no",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "pg071",
        "name": "會員更新",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          260,
          170
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO pps2_members(contact,name,total_spent,order_count)\nSELECT $1::jsonb->>'contact', $1::jsonb->>'customer_name', ($1::jsonb->>'amount_total')::int, 1\nWHERE coalesce($1::jsonb->>'contact','') <> ''\nON CONFLICT (contact) DO UPDATE SET\n  total_spent = pps2_members.total_spent + EXCLUDED.total_spent,\n  order_count = pps2_members.order_count + 1,\n  name = COALESCE(NULLIF(pps2_members.name,''), EXCLUDED.name),\n  updated_at = now()",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('彙整結果').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
