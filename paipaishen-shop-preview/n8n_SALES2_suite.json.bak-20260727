      {
        "id": "pg158",
        "name": "查訂單原值",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          1870
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT order_no, items, amount_total, customer_name, contact, ship_method, ship_addr, payment_method, raw\nFROM pps2_shop_orders WHERE order_no = $1::jsonb->'payload'->>'order_no'",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('角色閘').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "cd159",
        "name": "套用訂單編輯",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          1870
        ],
        "parameters": {
          "jsCode": "const g = $('角色閘').item.json;\nconst p = g.payload || {};\nconst old = $json;\nconst oldRaw = old.raw || {};\nconst skip = !old.order_no;\nconst merged = {\n  order_no: p.order_no, skip,\n  items: Array.isArray(p.items) ? p.items : old.items,\n  amount_total: (p.amount_total != null) ? Math.max(0, parseInt(p.amount_total,10) || 0) : old.amount_total,\n  customer_name: (p.customer_name != null) ? String(p.customer_name).slice(0,40) : old.customer_name,\n  contact: (p.contact != null) ? String(p.contact).slice(0,60) : old.contact,\n  ship_method: (p.ship_method != null) ? String(p.ship_method).slice(0,20) : old.ship_method,\n  ship_addr: (p.ship_addr != null) ? String(p.ship_addr).slice(0,200) : old.ship_addr,\n  raw: Object.assign({}, oldRaw, {\n    note: (p.note != null) ? String(p.note).slice(0,500) : oldRaw.note,\n    manual_discount: (p.discount != null) ? (parseInt(p.discount,10) || 0) : oldRaw.manual_discount\n  })\n};\nconst diff = {};\nif (!skip) {\n  ['items','amount_total','customer_name','contact','ship_method','ship_addr'].forEach(k => {\n    if (JSON.stringify(old[k]) !== JSON.stringify(merged[k])) diff[k] = { from: old[k], to: merged[k] };\n  });\n  if ((oldRaw.note||'') !== (merged.raw.note||'')) diff.note = { from: oldRaw.note||'', to: merged.raw.note||'' };\n  if ((oldRaw.manual_discount||0) !== (merged.raw.manual_discount||0)) diff.discount = { from: oldRaw.manual_discount||0, to: merged.raw.manual_discount||0 };\n}\nreturn [{ json: Object.assign({ actor: g.actor, role: g.role, diff }, merged) }];"
        }
      },
      {
        "id": "pg160",
        "name": "寫入訂單編輯",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          520,
          1870
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE pps2_shop_orders SET\n  items=($1::jsonb->'items'), amount_total=($1::jsonb->>'amount_total')::int,\n  customer_name=$1::jsonb->>'customer_name', contact=$1::jsonb->>'contact',\n  ship_method=$1::jsonb->>'ship_method', ship_addr=$1::jsonb->>'ship_addr',\n  raw=($1::jsonb->'raw'), updated_at=now()\nWHERE order_no=$1::jsonb->>'order_no' AND NOT COALESCE(($1::jsonb->>'skip')::boolean,false)\nRETURNING order_no",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('套用訂單編輯').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
