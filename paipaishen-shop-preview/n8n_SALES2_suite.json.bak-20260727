  {
    "id": "pps2Admin001",
    "name": "pps2-admin",
    "active": true,
    "nodes": [
      {
        "id": "wh076",
        "name": "Webhook 後台",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "pps2-admin",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "pps2-admin"
      },
      {
        "id": "cd077",
        "name": "解析輸入",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nif (JSON.stringify(b).length > 10000) throw new Error('payload too big');\nconst OPS = [\"ping\",\"order_list\",\"order_update\",\"member_list\",\"member_upsert\",\"coupon_list\",\"coupon_save\",\"coupon_delete\",\"faq_list\",\"faq_save\",\"faq_delete\",\"settings_set\",\"audit_list\",\"user_save\",\"settings_get\",\"report_summary\",\"user_list\",\"payment_add\",\"payment_list\",\"order_edit\",\"settings_enum_get\",\"settings_enum_set\",\"member_detail\",\"member_export\",\"report_revenue\"];\nconst op = String(b.op || '');\nconst idx = OPS.indexOf(op);\nif (idx < 0) throw new Error('bad op');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nreturn [{ json: {\n  _branch: idx, op,\n  role_token: s(b.role_token, 400), actor: s(b.actor, 30), role: s(b.role, 10),\n  payload: (b.payload && typeof b.payload === 'object') ? b.payload : b\n} }];"
        }
      },
      {
        "id": "pg078",
        "name": "驗Token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          520,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\ns AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nparts AS (SELECT string_to_array(coalesce((SELECT j->>'role_token' FROM p),''), '|') AS a),\nvalid_shape AS (SELECT a FROM parts WHERE array_length(a,1)=4 AND a[3] ~ '^[0-9]+$')\nSELECT EXISTS (\n  SELECT 1 FROM valid_shape v, s\n  WHERE v.a[1] = (SELECT j->>'actor' FROM p)\n    AND v.a[2] = (SELECT j->>'role' FROM p)\n    AND v.a[3]::bigint > extract(epoch FROM now())::bigint\n    AND v.a[4] = encode(hmac(v.a[1]||'|'||v.a[2]||'|'||v.a[3], s.secret, 'sha256'), 'hex')\n) AS valid, (SELECT j->>'role' FROM p) AS verified_role",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd079",
        "name": "角色閘",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          780,
          0
        ],
        "parameters": {
          "jsCode": "const v = $json; const req = $('解析輸入').item.json;\nconst MATRIX = {\"ping\":[\"owner\",\"客服\",\"倉管\",\"行銷\"],\"order_list\":[\"owner\",\"客服\",\"倉管\"],\"order_update\":[\"owner\",\"客服\",\"倉管\"],\"order_edit\":[\"owner\",\"客服\",\"倉管\"],\"member_list\":[\"owner\",\"客服\"],\"member_upsert\":[\"owner\",\"客服\"],\"member_detail\":[\"owner\",\"客服\"],\"member_export\":[\"owner\"],\"coupon_list\":[\"owner\",\"行銷\"],\"coupon_save\":[\"owner\",\"行銷\"],\"coupon_delete\":[\"owner\",\"行銷\"],\"faq_list\":[\"owner\",\"客服\"],\"faq_save\":[\"owner\",\"客服\"],\"faq_delete\":[\"owner\",\"客服\"],\"audit_list\":[\"owner\"],\"user_save\":[\"owner\"],\"user_list\":[\"owner\"],\"settings_get\":[\"owner\",\"客服\",\"倉管\",\"行銷\"],\"settings_enum_get\":[\"owner\",\"客服\",\"倉管\",\"行銷\"],\"settings_enum_set\":[\"owner\",\"倉管\"],\"report_summary\":[\"owner\",\"行銷\"],\"report_revenue\":[\"owner\",\"行銷\"],\"payment_add\":[\"owner\",\"客服\"],\"payment_list\":[\"owner\",\"客服\"]};\nconst SETTINGS_KEY_ROLES = {\"auth_secret\":[\"owner\"],\"low_stock_threshold\":[\"owner\",\"倉管\"],\"ecpay\":[\"owner\",\"倉管\"],\"ga4_id\":[\"owner\",\"行銷\"],\"meta_pixel_id\":[\"owner\",\"行銷\"],\"notify_templates\":[\"owner\",\"客服\"]};\nlet ok = false;\nif (v.valid === true) {\n  if (req.op === 'settings_set') {\n    const key = String((req.payload && req.payload.key) || '');\n    const allowed = SETTINGS_KEY_ROLES[key] || ['owner'];\n    ok = allowed.includes(v.verified_role);\n  } else {\n    ok = (MATRIX[req.op] || []).includes(v.verified_role);\n  }\n}\nreturn [{ json: {\n  ok, _branch: req._branch, op: req.op, actor: req.actor, role: req.role,\n  is_owner: v.verified_role === 'owner', payload: req.payload\n} }];"
        }
      },
      {
