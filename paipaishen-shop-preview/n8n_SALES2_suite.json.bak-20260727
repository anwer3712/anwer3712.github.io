        "id": "pg130",
        "name": "報表聚合",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          1530
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT to_char(date_trunc('day',created_at),'YYYY-MM-DD') AS day, count(*) AS orders, sum(amount_total) AS revenue\nFROM pps2_shop_orders WHERE created_at > now() - interval '180 days' AND status <> '新單'\nGROUP BY 1 ORDER BY 1",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
