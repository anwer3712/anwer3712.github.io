      {
        "id": "pg186",
        "name": "驗OTP",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          340
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id, contact, login_email,\n  (otp_hash = encode(digest($1::jsonb->>'email'||'|'||$1::jsonb->>'otp_code','sha256'),'base64')\n   AND otp_expires > now()) AS otp_ok\nFROM pps2_members WHERE login_email = $1::jsonb->>'email'",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
