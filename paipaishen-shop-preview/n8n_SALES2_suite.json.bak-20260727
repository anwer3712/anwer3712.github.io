          "query": "WITH m AS (SELECT contact, login_email FROM pps2_members WHERE id = ($1::jsonb->>'member_id')::bigint)\nSELECT order_no, 'shop' AS order_type, status, amount_total, created_at, updated_at\nFROM pps2_shop_orders, m WHERE pps2_shop_orders.contact = m.contact\nUNION ALL\nSELECT order_id AS order_no, 'custom' AS order_type, status, NULL::int AS amount_total, created_at, updated_at\nFROM orders, m WHERE m.login_email IS NOT NULL AND orders.email = m.login_email\nORDER BY created_at DESC",
