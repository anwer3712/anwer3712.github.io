          "query": "INSERT INTO pps2_coupons(code,discount_percent,discount_amount,min_amount,max_uses,expires_at,status)\nSELECT $1::jsonb->'payload'->>'code', ($1::jsonb->'payload'->>'discount_percent')::int, ($1::jsonb->'payload'->>'discount_amount')::int,\n       COALESCE(($1::jsonb->'payload'->>'min_amount')::int,0), ($1::jsonb->'payload'->>'max_uses')::int,\n       NULLIF($1::jsonb->'payload'->>'expires_at','')::timestamptz, COALESCE(NULLIF($1::jsonb->'payload'->>'status',''),'啟用')\nON CONFLICT (code) DO UPDATE SET\n  discount_percent = EXCLUDED.discount_percent, discount_amount = EXCLUDED.discount_amount,\n  min_amount = EXCLUDED.min_amount, max_uses = EXCLUDED.max_uses,\n  expires_at = EXCLUDED.expires_at, status = EXCLUDED.status\nRETURNING code",
