          "options": {
            "queryReplacement": "={{ JSON.stringify({ actor: $('套用訂單編輯').item.json.actor, role: $('套用訂單編輯').item.json.role, action: 'order_edit', target: String($('寫入訂單編輯').item.json.order_no||''), detail: $('套用訂單編輯').item.json.diff }) }}"
          }
