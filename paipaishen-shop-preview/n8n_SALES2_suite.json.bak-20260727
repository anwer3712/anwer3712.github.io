        "name": "簽發member_token並清OTP",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1040,
          340
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH s AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nt AS (SELECT ($1::jsonb->>'member_id')::bigint AS mid, (extract(epoch FROM now())::bigint + 86400) AS exp),\nclr AS (UPDATE pps2_members SET otp_hash=NULL, otp_expires=NULL WHERE id=(SELECT mid FROM t))\nSELECT 'member|'||t.mid||'|'||t.exp||'|'||encode(hmac('member|'||t.mid||'|'||t.exp, s.secret, 'sha256'),'hex') AS member_token,\n       t.exp AS exp, t.mid AS member_id\nFROM s, t",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('核對OTP').item.json) }}"
          }
        },
        "credentials": {
