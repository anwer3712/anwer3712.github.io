        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO pps2_members(contact,name,email,tags,note,login_email,profile)\nSELECT $1::jsonb->'payload'->>'contact', $1::jsonb->'payload'->>'name', $1::jsonb->'payload'->>'email',\n       COALESCE($1::jsonb->'payload'->'tags','[]'::jsonb), $1::jsonb->'payload'->>'note',\n       NULLIF($1::jsonb->'payload'->>'login_email',''), COALESCE($1::jsonb->'payload'->'profile','{}'::jsonb)\nON CONFLICT (contact) DO UPDATE SET\n  name = EXCLUDED.name, email = EXCLUDED.email, tags = EXCLUDED.tags, note = EXCLUDED.note,\n  login_email = COALESCE(NULLIF($1::jsonb->'payload'->>'login_email',''), pps2_members.login_email),\n  profile = CASE WHEN $1::jsonb->'payload'->'profile' IS NOT NULL THEN ($1::jsonb->'payload'->'profile') ELSE pps2_members.profile END,\n  updated_at = now()\nRETURNING id, contact",
          "options": {
