        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE pps2_products SET stock = stock + ($1::jsonb->>'delta')::int, updated_at=now()\nWHERE id = ($1::jsonb->>'id')::bigint AND stock + ($1::jsonb->>'delta')::int >= 0\nRETURNING id, stock",
          "options": {
            "queryReplacement": "={{ JSON.stringify({ id: $('角色閘').item.json.id, delta: $('角色閘').item.json.delta }) }}"
