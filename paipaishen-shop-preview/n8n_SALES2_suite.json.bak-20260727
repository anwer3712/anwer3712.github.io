        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\nitems AS (SELECT (e->>'id')::bigint AS id, (e->>'qty')::int AS qty FROM p, jsonb_array_elements(p.j->'rollback') e)\nUPDATE pps2_products pr SET stock = pr.stock + i.qty FROM items i WHERE pr.id = i.id",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('彙整結果').item.json) }}"
