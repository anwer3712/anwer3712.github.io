  {
    "id": "pps2Auth0001",
    "name": "pps2-auth",
    "active": true,
    "nodes": [
      {
        "id": "wh001",
        "name": "Webhook 登入",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "pps2-auth",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "pps2-auth"
      },
      {
        "id": "cd002",
        "name": "解析輸入",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nif (JSON.stringify(b).length > 4000) throw new Error('payload too big');\nconst op = String(b.op || 'login');\nconst OPS = ['login','register','set_totp','ping'];\nconst idx = OPS.indexOf(op);\nif (idx < 0) throw new Error('bad op');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nif (op !== 'ping' && b.token !== \"pps_07ae287ed522c33e0422fdd4837d97bf\") throw new Error('bad token');\nreturn [{ json: {\n  _branch: idx, op,\n  username: s(b.username, 30).trim(), pin_hash: s(b.pin_hash, 100), totp_code: s(b.totp_code, 10),\n  role_token: s(b.role_token, 400), actor: s(b.actor, 30), role: s(b.role, 10),\n  new_username: s(b.new_username, 30).trim(), new_pin_hash: s(b.new_pin_hash, 100), new_role: s(b.new_role, 10),\n  target_username: s(b.target_username || b.actor, 30).trim(), totp_action: s(b.action, 10),\n  secret_base32: s(b.secret_base32, 64)\n} }];"
        }
      },
      {
        "id": "sw003",
        "name": "分流",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          520,
          0
        ],
        "parameters": {
          "mode": "expression",
          "numberOutputs": 4,
          "output": "={{ $json._branch }}"
        }
      },
      {
        "id": "rs004",
        "name": "回應pong",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          780,
          0
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: true, msg: 'pong' } }}",
          "options": {}
        }
      },
      {
        "id": "pg005",
        "name": "查帳號",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1040,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id,username,pin_hash,role,totp_secret,totp_enabled,status\nFROM pps2_admin_users WHERE username=$1::jsonb->>'username' LIMIT 1",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析輸入').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "cd006",
        "name": "核對PIN",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1300,
          0
        ],
        "parameters": {
          "jsCode": "const acc = $json; const req = $('解析輸入').item.json;\nif (!acc.id) return [{ json: { ok: false, error: 'account_not_found' } }];\nif (acc.status !== '啟用') return [{ json: { ok: false, error: 'disabled' } }];\nif (acc.pin_hash !== req.pin_hash) return [{ json: { ok: false, error: 'bad_pin' } }];\nreturn [{ json: { ok: true, username: acc.username, role: acc.role, need_totp: !!acc.totp_enabled, totp_secret: acc.totp_secret, totp_code: req.totp_code } }];"
        }
      },
      {
        "id": "if007",
        "name": "PIN正確?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          0,
          170
        ],
