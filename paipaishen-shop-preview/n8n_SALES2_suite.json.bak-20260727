[
  {
    "id": "pps2Products01",
    "name": "pps2-products",
    "active": true,
    "nodes": [
      {
        "id": "wh036",
        "name": "Webhook 商品",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          0
        ],
        "parameters": {
          "httpMethod": "POST",
          "path": "pps2-products",
          "responseMode": "responseNode",
          "options": {}
        },
        "webhookId": "pps2-products"
      },
      {
        "id": "cd037",
        "name": "解析與分流",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "const b = $json.body || $json;\nif (JSON.stringify(b).length > 8000) throw new Error('payload too big');\nconst op = String(b.op || '');\nconst OPS = ['list','list_admin','save','delete','stock'];\nconst idx = OPS.indexOf(op);\nif (idx < 0) throw new Error('bad op');\nconst s = (v, n) => String(v ?? '').slice(0, n);\nreturn [{ json: {\n  _branch: idx, op,\n  token: s(b.token, 80), role_token: s(b.role_token, 400), actor: s(b.actor, 30), role: s(b.role, 10),\n  product: b.product || {}, id: b.id, delta: b.delta\n} }];"
        }
      },
      {
        "id": "sw038",
        "name": "分流",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          520,
          0
        ],
        "parameters": {
          "mode": "expression",
          "numberOutputs": 5,
          "output": "={{ $json._branch }}"
        }
      },
      {
        "id": "cd039",
        "name": "驗SITE_TOKEN",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          780,
          0
        ],
        "parameters": {
          "jsCode": "const j = $json;\nif (j.token !== \"pps_07ae287ed522c33e0422fdd4837d97bf\") throw new Error('bad token');\nreturn [{ json: {} }];"
        }
      },
      {
        "id": "pg040",
        "name": "查上架商品",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1040,
          0
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id,name,layout,aesthetic,size_cm,bead_mm,price,stock,photos,description,status,low_stock_mode,low_stock_value,crystals\nFROM pps2_products WHERE status='上架' ORDER BY created_at DESC",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd041",
        "name": "包裝商品清單",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1300,
          0
        ],
        "parameters": {
          "jsCode": "const rows = $input.all().map(x => x.json);\nconst products = rows.map(r => ({\n  id: r.id, name: r.name, category: r.layout, layout: r.layout, aesthetic: r.aesthetic,\n  price: r.price, stock: r.stock, photos: r.photos || [], desc: r.description || '',\n  active: r.status === '上架', crystals: r.crystals || [], low_stock_mode: r.low_stock_mode || 'inherit', low_stock_value: r.low_stock_value\n}));\nreturn [{ json: { ok: true, products } }];"
        }
      },
      {
        "id": "rs042",
        "name": "回應清單",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          0,
          170
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {}
        }
      },
      {
        "id": "pg043",
        "name": "驗Token",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          260,
          170
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "WITH p AS (SELECT $1::jsonb AS j),\ns AS (SELECT value#>>'{}' AS secret FROM pps2_settings WHERE key='auth_secret'),\nparts AS (SELECT string_to_array(coalesce((SELECT j->>'role_token' FROM p),''), '|') AS a),\nvalid_shape AS (SELECT a FROM parts WHERE array_length(a,1)=4 AND a[3] ~ '^[0-9]+$')\nSELECT EXISTS (\n  SELECT 1 FROM valid_shape v, s\n  WHERE v.a[1] = (SELECT j->>'actor' FROM p)\n    AND v.a[2] = (SELECT j->>'role' FROM p)\n    AND v.a[3]::bigint > extract(epoch FROM now())::bigint\n    AND v.a[4] = encode(hmac(v.a[1]||'|'||v.a[2]||'|'||v.a[3], s.secret, 'sha256'), 'hex')\n) AS valid, (SELECT j->>'role' FROM p) AS verified_role",
          "options": {
            "queryReplacement": "={{ JSON.stringify($('解析與分流').item.json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd044",
        "name": "角色閘",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          520,
          170
        ],
        "parameters": {
          "jsCode": "const v = $json;\nconst req = $('解析與分流').item.json;\nconst ALLOWED = [\"owner\",\"倉管\"];\nconst ok = v.valid === true && ALLOWED.includes(v.verified_role);\nreturn [{ json: { ok, op: req.op, actor: req.actor, role: req.role, product: req.product, id: req.id, delta: req.delta } }];"
        }
      },
      {
        "id": "if045",
        "name": "授權通過?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          780,
          170
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "version": 2
            },
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ $json.ok }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "rs046",
        "name": "回應無權限",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          1040,
          170
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ { ok: false, error: 'forbidden' } }}",
          "options": {}
        }
      },
      {
        "id": "sw047",
        "name": "分流admin",
        "type": "n8n-nodes-base.switch",
        "typeVersion": 3.2,
        "position": [
          1300,
          170
        ],
        "parameters": {
          "mode": "expression",
          "numberOutputs": 4,
          "output": "={{ ({list_admin:0,save:1,delete:2,stock:3})[$json.op] }}"
        }
      },
      {
        "id": "pg048",
        "name": "查全部商品",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          340
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "SELECT id,name,layout,aesthetic,size_cm,bead_mm,price,stock,photos,description,status,low_stock_mode,low_stock_value,crystals,created_at\nFROM pps2_products ORDER BY created_at DESC",
          "options": {}
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        }
      },
      {
        "id": "cd049",
        "name": "包裝全部商品",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          340
        ],
        "parameters": {
          "jsCode": "return [{ json: { ok: true, products: $input.all().map(x => x.json) } }];"
        }
      },
      {
        "id": "rs050",
        "name": "回應全部商品",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          520,
          340
        ],
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ $json }}",
          "options": {}
        }
      },
      {
        "id": "cd051",
        "name": "準備商品欄位",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          780,
          340
        ],
        "parameters": {
          "jsCode": "const g = $('角色閘').item.json;\nconst p = g.product || {};\nconst s = (v, n) => String(v ?? '').slice(0, n);\nconst status = (p.active === false || p.status === '下架') ? '下架' : '上架';\nconst low_stock_mode = ['inherit','custom','off'].includes(p.low_stock_mode) ? p.low_stock_mode : 'inherit';\nreturn [{ json: {\n  id: p.id || null, name: s(p.name, 60), layout: s(p.layout, 30), aesthetic: s(p.aesthetic, 20),\n  size_cm: Number(p.size_cm) || null, bead_mm: parseInt(p.bead_mm, 10) || null,\n  price: Math.max(0, parseInt(p.price, 10) || 0), stock: Math.max(0, parseInt(p.stock, 10) || 0),\n  photos: Array.isArray(p.photos) ? p.photos.slice(0, 10) : [], description: s(p.description, 2000),\n  status, low_stock_mode, low_stock_value: (p.low_stock_value != null ? (parseInt(p.low_stock_value,10) || 0) : null),\n  crystals: Array.isArray(p.crystals) ? p.crystals.slice(0, 20).map(x => s(x, 20)) : [],\n  actor: g.actor, role: g.role\n} }];"
        }
      },
      {
        "id": "if052",
        "name": "有ID?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2.2,
        "position": [
          1040,
          340
        ],
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "version": 2
            },
            "combinator": "and",
            "conditions": [
              {
                "leftValue": "={{ !!$json.id }}",
                "rightValue": "",
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ]
          },
          "options": {}
        }
      },
      {
        "id": "pg053",
        "name": "更新商品",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          1300,
          340
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "UPDATE pps2_products SET\n  name=$1::jsonb->>'name', layout=$1::jsonb->>'layout', aesthetic=$1::jsonb->>'aesthetic',\n  size_cm=($1::jsonb->>'size_cm')::numeric, bead_mm=($1::jsonb->>'bead_mm')::int,\n  price=($1::jsonb->>'price')::int, stock=($1::jsonb->>'stock')::int,\n  photos=($1::jsonb->'photos'), description=$1::jsonb->>'description', status=$1::jsonb->>'status',\n  low_stock_mode=COALESCE(NULLIF($1::jsonb->>'low_stock_mode',''),'inherit'), low_stock_value=($1::jsonb->>'low_stock_value')::int,\n  crystals=COALESCE($1::jsonb->'crystals','[]'::jsonb),\n  updated_at=now()\nWHERE id=($1::jsonb->>'id')::bigint RETURNING id",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "pg054",
        "name": "新增商品",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          0,
          510
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO pps2_products(name,layout,aesthetic,size_cm,bead_mm,price,stock,photos,description,status,low_stock_mode,low_stock_value,crystals)\nSELECT $1::jsonb->>'name', $1::jsonb->>'layout', $1::jsonb->>'aesthetic', ($1::jsonb->>'size_cm')::numeric,\n       ($1::jsonb->>'bead_mm')::int, ($1::jsonb->>'price')::int, ($1::jsonb->>'stock')::int,\n       ($1::jsonb->'photos'), $1::jsonb->>'description', $1::jsonb->>'status',\n       COALESCE(NULLIF($1::jsonb->>'low_stock_mode',''),'inherit'), ($1::jsonb->>'low_stock_value')::int, COALESCE($1::jsonb->'crystals','[]'::jsonb)\nRETURNING id",
          "options": {
            "queryReplacement": "={{ JSON.stringify($json) }}"
          }
        },
        "credentials": {
          "postgres": {
            "id": "VlUClUMAVuxVid9c",
            "name": "Postgres account"
          }
        },
        "alwaysOutputData": true
      },
      {
        "id": "pg055",
        "name": "審計save",
        "type": "n8n-nodes-base.postgres",
        "typeVersion": 2.6,
        "position": [
          260,
          510
        ],
        "parameters": {
          "operation": "executeQuery",
          "query": "INSERT INTO pps2_audit_log(actor, role, action, target, detail)\nSELECT $1::jsonb->>'actor', $1::jsonb->>'role', $1::jsonb->>'action', $1::jsonb->>'target', ($1::jsonb->'detail')",
          "options": {
